#!/bin/bash
set -euo pipefail
umask 077

fail() { printf 'omalab: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'HELP'
Usage: omalab up <plugin-dir> [-n NAME] [--theme NAME|mine] [--size WxH]
                 [--scale N] [--plus PLUGIN-ID ...] [--network] [--shared-bus] [--no-stamp]
       omalab show [-n NAME]
       omalab hide [-n NAME]
       omalab shot [-n NAME] [FILE] [--scale N] [--size WxH]
       omalab ipc [-n NAME] <target> <method> [args...]
       omalab exec [-n NAME] <cmd...>
       omalab input [-n NAME] move X Y | click X Y | type TEXT | key CHORD
       omalab log [-n NAME] [-f]
       omalab restart [-n NAME]
       omalab ls
       omalab down [-n NAME | --all]

Run omalab-setup once to prepare the private runtime dependencies.
Defaults: name default, theme tokyo-night, logical size 1280x800, scale 1.
No host display is added. show opens a normal viewer; hide closes only that viewer.
Plugin directories are live read-only mounts. exec starts in the scratch HOME.
Network and host services are isolated unless --network or --shared-bus is requested.
Scale-changing shots restart the lab shell and reset transient plugin state.
Input coordinates are original framebuffer pixels; type supports Unicode text.
HELP
}

valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$ ]] || fail 'name must be 1-48 letters, digits, underscores or hyphens'; }
valid_id() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && $1 != *..* ]] || fail "invalid plugin id: $1"; }
geometry() {
  [[ $SIZE =~ ^[1-9][0-9]*x[1-9][0-9]*$ && $SCALE =~ ^[0-9]+([.][0-9]+)?$ ]] || fail 'expected --size WxH and positive numeric --scale'
  jq -en --arg size "$SIZE" --argjson scale "$SCALE" '
    ($size|split("x")|map(tonumber)) as $s |
    $scale>0 and $scale<=4 and all($s[]; .>=200 and .<=8192) and
    all($s[]*$scale; .==floor and .<=16384)' >/dev/null || fail 'invalid geometry: 200-8192 logical pixels, scale up to 4, integral physical dimensions up to 16384'
  read -r PIXEL_W PIXEL_H < <(jq -nr --arg size "$SIZE" --argjson scale "$SCALE" '$size|split("x")|map(tonumber*$scale)|@tsv')
}

process_start() {
  local stat
  [[ $1 =~ ^[1-9][0-9]*$ && -r /proc/$1/stat ]] || return 1
  IFS= read -r stat < "/proc/$1/stat" || return 1
  local -a fields
  read -ra fields <<< "${stat##*) }"
  [[ ${fields[0]} != Z ]] || return 1
  printf '%s\n' "${fields[19]}"
}
record_pid() {
  local role=$1 pid=$2 start tmp=$PID_FILE.next
  start=$(process_start "$pid") || fail "$role exited during startup"
  if [[ -f $PID_FILE ]]; then
    while read -r old_role old_pid old_start; do
      [[ $old_role == "$role" ]] || printf '%s %s %s\n' "$old_role" "$old_pid" "$old_start"
    done < "$PID_FILE" > "$tmp"
  else : > "$tmp"; fi
  printf '%s %s %s\n' "$role" "$pid" "$start" >> "$tmp"
  mv -- "$tmp" "$PID_FILE"
}
role_alive() {
  local role pid start actual
  [[ -f $PID_FILE ]] || return 1
  while read -r role pid start; do
    [[ $role == "$1" ]] || continue
    actual=$(process_start "$pid") || return 1
    [[ $actual == "$start" ]] || return 1
    ROLE_PID=$pid
    return 0
  done < "$PID_FILE"
  return 1
}
stop_role() {
  local role=$1 pid start attempt target
  role_alive "$role" || return 0
  pid=$ROLE_PID; start=$(process_start "$pid")
  target=$pid
  [[ $role != supervisor && $role != viewer ]] || target=-$pid
  kill -TERM -- "$target" 2>/dev/null || true
  for ((attempt=0; attempt<100; attempt++)); do
    [[ $(process_start "$pid" || true) == "$start" ]] || return 0
    sleep 0.05
  done
  kill -KILL -- "$target" 2>/dev/null || true
  for ((attempt=0; attempt<50; attempt++)); do
    [[ $(process_start "$pid" || true) == "$start" ]] || return 0
    sleep 0.05
  done
  fail "$role did not stop; state retained"
}

load_lab() {
  valid_name "$NAME"
  LAB=$ROOT/$NAME
  [[ -d $LAB && ! -L $LAB && -O $LAB && -f $LAB/meta.json ]] || fail "no lab named $NAME"
  jq -e '.format==2' "$LAB/meta.json" >/dev/null || fail "$NAME uses the old host-output backend; stop it with its original CLI before upgrading"
  SIZE=$(jq -er .size "$LAB/meta.json")
  SCALE=$(jq -er .scale "$LAB/meta.json")
  PID_FILE=$LAB/pids
  geometry
}
namespace_alive() {
  role_alive supervisor && role_alive namespace
}
run_lab() {
  namespace_alive || fail 'lab namespace is not running; inspect supervisor.log'
  local keeper=$ROLE_PID
  local -a net_args=() exec_prefix=()
  [[ $COMMAND != exec ]] || exec_prefix=(exec)
  # A child user namespace cannot setns back into the parent's network namespace.
  # With --network we are already there; otherwise enter the lab's private one.
  if ! jq -e .network "$LAB/meta.json" >/dev/null; then net_args=(--net); fi
  # Enter only a verified owned user namespace, then its mount/PID/network spaces.
  "${exec_prefix[@]}" nsenter --target="$keeper" --user --mount --pid "${net_args[@]}" --ipc --uts \
    --preserve-credentials --root --wdns=/lab/home -- \
    /usr/bin/env -i PATH=/usr/bin:/omarchy/bin:/runtime/tools/usr/bin \
      OMALAB_INSIDE=1 /bin/bash /runner _run "$@" 9>&-
}

inside_environment() {
  [[ ${OMALAB_INSIDE:-} == 1 && -f /lab/meta.json && -d /lab/home ]] || fail 'internal command requires the lab namespace'
  LAB=/lab
  PID_FILE=/lab/session.pids
  SIZE=$(jq -er .size /lab/meta.json)
  SCALE=$(jq -er .scale /lab/meta.json)
  export HOME=/lab/home XDG_RUNTIME_DIR=/lab/run XDG_CONFIG_HOME=/lab/home/.config
  export XDG_STATE_HOME=/lab/home/.local/state XDG_DATA_HOME=/lab/home/.local/share XDG_CACHE_HOME=/lab/home/.cache TMPDIR=/lab/tmp
  export OMARCHY_PATH=/omarchy PATH=/runtime/tools/usr/bin:/usr/bin:/omarchy/bin
  export LANG=C.UTF-8 QT_QPA_PLATFORM=wayland QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1
  export PIPEWIRE_RUNTIME_DIR=/lab/run PIPEWIRE_REMOTE=pipewire-0
  unset DISPLAY WAYLAND_DISPLAY WAYLAND_SOCKET HYPRLAND_INSTANCE_SIGNATURE QT_QPA_PLATFORMTHEME AT_SPI_BUS_ADDRESS
  unset DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE HL_INITIAL_WORKSPACE_TOKEN HL_EXEC_RULE_TOKEN OMALAB_STAMP
  export LD_LIBRARY_PATH=/runtime/tools/usr/lib
  if jq -e .sharedBus /lab/meta.json >/dev/null; then
    export DBUS_SESSION_BUS_ADDRESS=unix:path=/host/bus QT_NO_XDG_DESKTOP_PORTAL=0
  else
    export DBUS_SESSION_BUS_ADDRESS=unix:path=/lab/run/bus QT_NO_XDG_DESKTOP_PORTAL=1
  fi
  if [[ -f /lab/env ]]; then
    local key value
    while IFS='=' read -r key value; do
      case $key in WAYLAND_DISPLAY|HYPRLAND_INSTANCE_SIGNATURE) export "$key=$value" ;; *) fail 'invalid child environment record' ;; esac
    done < /lab/env
  fi
  if [[ -f /lab/stamp.json ]]; then OMALAB_STAMP=$(</lab/stamp.json); export OMALAB_STAMP; fi
}
inside_launch() {
  local role=$1; shift
  "$@" </dev/null >>"/lab/$role.log" 2>&1 &
  record_pid "$role" "$!"
}
shell_ready() {
  local attempt
  for ((attempt=0; attempt<150; attempt++)); do
    role_alive shell || fail 'shell exited; inspect shell.log'
    if omarchy-shell shell ping >/dev/null 2>&1 &&
      hyprctl -j layers | jq -e '..|objects|select(.namespace?=="omarchy-bar")' >/dev/null; then
      if ! jq -e .stampEnabled /lab/meta.json >/dev/null ||
        hyprctl -j layers | jq -e '..|objects|select(.namespace?=="omalab-stamp")' >/dev/null; then return 0; fi
    fi
    sleep 0.1
  done
  fail 'shell layers/IPC did not become ready'
}
inside_restart() {
  touch /lab/restarting
  trap 'rm -f /lab/restarting' EXIT
  stop_role shell
  inside_launch shell quickshell -n -p /omarchy/shell
  shell_ready
  rm -- /lab/restarting
  trap - EXIT
}
inside_supervise() {
  inside_environment
  rm -f /lab/ready /lab/restarting /lab/env /lab/child.env
  : > /lab/session.pids
  trap 'status=$?; rm -f /lab/ready; exit "$status"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  omarchy-theme-set-templates > /lab/theme.log 2>&1
  mv /lab/home/.local/state/omarchy/current/next-theme /lab/home/.local/state/omarchy/current/theme
  if ! jq -e .sharedBus /lab/meta.json >/dev/null; then
    inside_launch bus dbus-daemon --session --nofork --address="$DBUS_SESSION_BUS_ADDRESS"
  fi
  inside_launch pipewire pipewire -c /lab/omalab-pipewire.conf
  inside_launch parent env LD_LIBRARY_PATH=/runtime/lib:/runtime/tools/usr/lib \
    WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_RENDERER=gles2 \
    WLR_RENDER_DRM_DEVICE="$RENDER_NODE" WLR_LIBINPUT_NO_DEVICES=1 \
    /parent -d -- Hyprland --config /lab/hyprland.lua
  local attempt
  for ((attempt=0; attempt<300; attempt++)); do
    role_alive parent || fail 'isolated parent/child failed; inspect parent.log'
    [[ ! -s /lab/child.env ]] || break
    sleep 0.1
  done
  [[ -s /lab/child.env ]] || fail 'child did not report its identity'
  local key value
  while IFS='=' read -r key value; do
    case $key in WAYLAND_DISPLAY|HYPRLAND_INSTANCE_SIGNATURE) printf '%s=%s\n' "$key" "$value" ;; esac
  done < /lab/child.env > /lab/env
  inside_environment
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -n ${WAYLAND_DISPLAY:-} ]] || fail 'missing child identity'
  record_pid compositor "$(hyprctl -j instances | jq -er --arg sig "$HYPRLAND_INSTANCE_SIGNATURE" '.[]|select(.instance==$sig)|.pid')"
  hyprctl output create headless LAB
  geometry
  for ((attempt=0; attempt<150; attempt++)); do
    if hyprctl -j monitors | jq -e --argjson w "$PIXEL_W" --argjson h "$PIXEL_H" --argjson s "$SCALE" '.[]|select(.name=="LAB" and .width==$w and .height==$h and .scale==$s)' >/dev/null; then break; fi
    sleep 0.1
  done
  (( attempt < 150 )) || fail 'child LAB output did not become ready'
  inside_launch shell quickshell -n -p /omarchy/shell
  shell_ready
  # Persistent virtual devices and a private socket for viewers/input automation.
  inside_launch vnc /vnc -u -o LAB -R -L info -n "omalab: $(jq -er .name /lab/meta.json)" -S /lab/run/vnc-control.sock /lab/run/viewer.sock
  for ((attempt=0; attempt<100; attempt++)); do
    role_alive vnc || fail 'private viewer server failed; inspect vnc.log'
    [[ ! -S /lab/run/viewer.sock ]] || break
    sleep 0.05
  done
  [[ -S /lab/run/viewer.sock ]] || fail 'private viewer socket did not become ready'
  inside_launch input python3 /support/input.py serve /lab/run/input.sock /lab/run/viewer.sock
  for ((attempt=0; attempt<100; attempt++)); do
    role_alive input || fail 'input controller failed; inspect input.log'
    [[ ! -S /lab/run/input.sock ]] || break
    sleep 0.05
  done
  [[ -S /lab/run/input.sock ]] || fail 'input controller did not become ready'
  # Ping precedes asynchronous wallpaper/theme loading; let initial frames settle.
  sleep 1
  touch /lab/ready
  printf 'Isolated session ready\n'
  while [[ ! -f /lab/stopping ]]; do
    sleep 1
    for key in parent compositor pipewire vnc input; do role_alive "$key" || fail "$key exited; stopping isolated session"; done
    if ! jq -e .sharedBus /lab/meta.json >/dev/null; then role_alive bus || fail 'private bus exited'; fi
    if [[ ! -e /lab/restarting ]]; then role_alive shell || fail 'shell exited; stopping isolated session'; fi
  done
  for key in input vnc shell pipewire bus compositor parent; do stop_role "$key"; done
}

stage_plugin() {
  local dir=$1 manifest=${2:-$1/manifest.json} id section config=$LAB/home/.config/omarchy/shell.json
  [[ -f $manifest ]] || fail "plugin manifest missing: $manifest"
  id=$(jq -er '.id|select(type=="string")' "$manifest"); valid_id "$id"
  case $id in omarchy.idle|omarchy.lock|omarchy.battery|omarchy.polkit|omarchy.nightlight) fail "$id controls the real machine and is disabled" ;; esac
  if [[ $# == 1 ]]; then
    ln -sfnT -- "/plugins/$id" "$LAB/home/.config/omarchy/plugins/$id"
    jq --arg id "$id" --arg source "$dir" 'map(select(.id!=$id))+[{id:$id,source:$source}]' "$LAB/mounts.json" > "$LAB/mounts.next"
    mv "$LAB/mounts.next" "$LAB/mounts.json"
  fi
  section=$(jq -r 'if (.kinds|index("bar-widget")) then .barWidget.defaultSection // "right" else "" end' "$manifest")
  [[ -z $section || $section == left || $section == center || $section == right ]] || fail "invalid defaultSection for $id"
  jq --arg id "$id" --arg section "$section" '
    .plugins=((.plugins // []|map(select(.id!=$id)))+[{id:$id}]) |
    .disabledPlugins|=map(select(.!=$id)) |
    if $section!="" then .bar.layout|=with_entries(.value|=map(select(.id!=$id))) | .bar.layout[$section]+=[{id:$id}] else . end
  ' "$config" > "$config.next"
  mv "$config.next" "$config"
}
stage_home() {
  mkdir -p "$LAB/home/.config/omarchy/plugins" "$LAB/home/.local/state/omarchy/current/next-theme" "$LAB/home/.local/share" "$LAB/home/.cache" "$LAB/run" "$LAB/tmp"
  local current=$LAB/home/.local/state/omarchy/current source background extra manifest found
  if [[ $THEME == mine ]]; then
    source=$REAL_STATE/omarchy/current/theme
    [[ -d $source && -f $REAL_STATE/omarchy/current/background ]] || fail 'host theme/background unavailable'
    cp -L -- "$REAL_STATE/omarchy/current/background" "$current/background"
  else
    valid_id "$THEME"
    source=$OMARCHY_PATH/themes/$THEME
    [[ -d $source ]] || source=$REAL_CONFIG/omarchy/themes/$THEME
    [[ -d $source ]] || fail "theme not found: $THEME"
  fi
  cp -aL -- "$source/." "$current/next-theme/"
  if [[ $THEME != mine ]]; then
    for background in "$current/next-theme/backgrounds/"*; do
      [[ -f $background ]] || continue
      ln -s -- "theme/backgrounds/${background##*/}" "$current/background"
      break
    done
    [[ -L $current/background ]] || fail 'theme has no background'
  fi
  jq '.disabledPlugins=((.disabledPlugins // [])+["omarchy.idle","omarchy.lock","omarchy.battery","omarchy.polkit","omarchy.nightlight","omarchy.notifications"]|unique)' "$OMARCHY_PATH/config/omarchy/shell.json" > "$LAB/home/.config/omarchy/shell.json"
  printf '[]\n' > "$LAB/mounts.json"
  stage_plugin "$PLUGIN_DIR"
  for extra in "${PLUS[@]}"; do
    valid_id "$extra"; source=$REAL_CONFIG/omarchy/plugins/$extra
    if [[ -f $source/manifest.json ]]; then stage_plugin "$(realpath -e -- "$source")"; continue; fi
    found=0
    shopt -s globstar nullglob
    for manifest in "$OMARCHY_PATH"/shell/plugins/**/manifest.json "$OMARCHY_PATH"/shell/plugins/**/*.manifest.json; do
      if jq -e --arg id "$extra" '.id==$id' "$manifest" >/dev/null; then stage_plugin "${manifest%/*}" "$manifest"; found=1; break; fi
    done
    shopt -u globstar nullglob
    (( found )) || fail "plugin not installed: $extra"
  done
  (( STAMP == 0 )) || stage_plugin "$(realpath -e -- "${SELF%/*}/../stamp")"
}
update_stamp() {
  jq -e .stampEnabled "$LAB/meta.json" >/dev/null || return 0
  local checkout commit dirty=false
  checkout=$(jq -er .pluginDir "$LAB/meta.json")
  commit=$(git -C "$checkout" rev-parse --short=8 HEAD 2>/dev/null) || commit=unversioned
  if [[ $commit != unversioned && -n $(git --no-optional-locks -C "$checkout" status --porcelain 2>/dev/null) ]]; then dirty=true; fi
  jq -c --arg commit "$commit" --argjson dirty "$dirty" --arg size "$SIZE" --argjson scale "$SCALE" --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{plugin:.plugin,commit:$commit,dirty:$dirty,theme:.theme,size:$size,scale:$scale,date:$date}' "$LAB/meta.json" > "$LAB/stamp.next"
  mv "$LAB/stamp.next" "$LAB/stamp.json"
}
write_child_config() {
  cat > "$LAB/hyprland.lua.next" <<CONFIG
hl.monitor({output="LAB", mode="${PIXEL_W}x${PIXEL_H}@60", position="0x0", scale=$SCALE})
hl.config({
  misc = { disable_hyprland_logo=true, disable_splash_rendering=true, disable_watchdog_warning=true },
  xwayland = { enabled=false },
  animations = { enabled=false },
})
hl.on("hyprland.start", function() hl.exec_cmd("env > /lab/child.env") end)
CONFIG
  mv "$LAB/hyprland.lua.next" "$LAB/hyprland.lua"
}
runtime_binary() {
  if [[ -x $RUNTIME_ROOT/tools/usr/bin/$1 ]]; then printf '%s\n' "$RUNTIME_ROOT/tools/usr/bin/$1"; else command -v "$1"; fi
}
prepare_namespace_args() {
  local render id source
  render=$(jq -er .renderNode "$LAB/meta.json")
  NAMESPACE_ARGS=(--unshare-all --new-session --die-with-parent --ro-bind /usr /usr --ro-bind /etc /etc --ro-bind /sys /sys
    --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib /lib64 --proc /proc --dev /dev
    --dev-bind "$render" "$render" --tmpfs /run --tmpfs /tmp --bind "$LAB" /lab
    --ro-bind "$OMARCHY_PATH" /omarchy --ro-bind "$RUNTIME_ROOT" /runtime --ro-bind "$SELF" /runner
    --ro-bind "$(realpath -e -- "${SELF%/*}/../support")" /support
    --ro-bind "$CAGE" /parent --ro-bind "$VNC" /vnc)
  (( NETWORK == 0 )) || NAMESPACE_ARGS+=(--share-net)
  if (( SHARED )); then NAMESPACE_ARGS+=(--ro-bind "$BUS_SOCKET" /host/bus); fi
  while IFS=$'\t' read -r id source; do NAMESPACE_ARGS+=(--ro-bind "$source" "/plugins/$id"); done < <(jq -r '.[]|[.id,.source]|@tsv' "$LAB/mounts.json")
  NAMESPACE_ARGS+=(--clearenv --setenv PATH /usr/bin --setenv OMALAB_INSIDE 1 --setenv RENDER_NODE "$render" --chdir /lab --info-fd 8 /bin/bash /runner _supervise)
}
launch_external() {
  local role=$1; shift
  rm -f "$LAB/$role.pid"
  # The new session's PID is recorded before its exec chain, not the launcher's.
  # shellcheck disable=SC2016
  setsid --fork bash -c 'printf "%s\n" "$$" > "$1"; shift; exec "$@"' bash "$LAB/$role.pid" "$@" \
    </dev/null >>"$LAB/$role.log" 2>&1 9>&- 8>"$LAB/$role-info.json"
  local attempt pid
  for ((attempt=0; attempt<100; attempt++)); do
    if [[ -s $LAB/$role.pid ]]; then read -r pid < "$LAB/$role.pid"; record_pid "$role" "$pid"; return; fi
    sleep 0.05
  done
  fail "$role did not launch"
}
stop_namespace() {
  local attempt
  touch "$LAB/stopping"
  for ((attempt=0; attempt<40; attempt++)); do
    role_alive namespace || break
    sleep 0.1
  done
  stop_role namespace
  stop_role supervisor
}
startup_failed() {
  local status=$?
  trap - EXIT INT TERM
  if (( status != 0 )); then
    printf 'omalab: startup failed; diagnostics retained in %s\n' "$LAB" >&2
    stop_namespace || true
    rm -f "$LAB/ready"
  fi
  exit "$status"
}
up() {
  [[ $# -gt 0 && $1 != -* ]] || fail 'up requires a plugin directory'
  PLUGIN_DIR=$(realpath -e -- "$1"); shift
  NAME=default THEME=tokyo-night SIZE=1280x800 SCALE=1 SHARED=0 NETWORK=0 STAMP=1; PLUS=()
  while (( $# )); do
    case $1 in
      -n|--theme|--size|--scale)
        [[ $# -ge 2 ]] || fail "missing value for $1"
        case $1 in -n) NAME=$2 ;; --theme) THEME=$2 ;; --size) SIZE=$2 ;; --scale) SCALE=$2 ;; esac; shift 2 ;;
      --plus) shift; [[ $# -gt 0 && $1 != -* ]] || fail '--plus requires plugin ids'; while [[ $# -gt 0 && $1 != -* ]]; do PLUS+=("$1"); shift; done ;;
      --shared-bus) SHARED=1; shift ;;
      --network) NETWORK=1; shift ;;
      --no-stamp) STAMP=0; shift ;;
      *) fail "unknown up option: $1" ;;
    esac
  done
  valid_name "$NAME"; geometry
  [[ -f $PLUGIN_DIR/manifest.json ]] || fail 'plugin manifest missing'
  PLUGIN_ID=$(jq -er .id "$PLUGIN_DIR/manifest.json"); valid_id "$PLUGIN_ID"
  [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/shell/shell.qml ]] || fail 'OMARCHY_PATH must identify the Omarchy installation'
  OMARCHY_PATH=$(realpath -e -- "$OMARCHY_PATH")
  RUNTIME_ROOT=${OMALAB_RUNTIME_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omalab-runtime}
  [[ -f $RUNTIME_ROOT/manifest.json && -f $RUNTIME_ROOT/lib/libaquamarine.so.13 ]] || fail 'private runtime unavailable; run omalab-setup'
  jq -e '.format==1 and .aquamarineVersion=="0.14.0"' "$RUNTIME_ROOT/manifest.json" >/dev/null || fail 'incompatible private runtime; run omalab-setup'
  [[ $(pkg-config --modversion aquamarine) == 0.14.0 ]] || fail 'installed Aquamarine changed; this runtime requires version 0.14.0 / ABI 13'
  RUNTIME_ROOT=$(realpath -e -- "$RUNTIME_ROOT")
  CAGE=$(runtime_binary cage) || fail 'cage unavailable; run omalab-setup'
  VNC=$(runtime_binary wayvnc) || fail 'wayvnc unavailable; run omalab-setup'
  CAGE=$(realpath -e -- "$CAGE"); VNC=$(realpath -e -- "$VNC")
  local tool render=${OMALAB_RENDER_NODE:-}
  for tool in bwrap nsenter hyprctl Hyprland quickshell grim jq dbus-daemon pipewire python3 wtype; do command -v "$tool" >/dev/null || fail "missing dependency: $tool"; done
  if [[ -z $render ]]; then for render in /dev/dri/renderD*; do [[ ! -c $render ]] || break; done; fi
  [[ $render =~ ^/dev/dri/renderD[0-9]+$ && -c $render && -r $render && -w $render ]] || fail 'an accessible GPU render node is required; display-control card nodes are forbidden'
  BUS_SOCKET=''
  if (( SHARED )); then
    [[ ${DBUS_SESSION_BUS_ADDRESS:-} =~ ^unix:path=([^,\;]+)(,guid=[0-9a-f]+)?$ ]] || fail '--shared-bus requires a filesystem Unix session-bus address'
    BUS_SOCKET=${BASH_REMATCH[1]}
    [[ -S $BUS_SOCKET ]] || fail 'requested shared bus socket does not exist'
  fi
  LAB=$ROOT/$NAME; PID_FILE=$LAB/pids
  [[ ! -e $LAB && ! -L $LAB ]] || fail "$NAME already exists; use down first"
  (( ${#LAB} + 16 <= 107 )) || fail 'runtime path too long for viewer socket'
  mkdir "$LAB"
  jq -n --arg name "$NAME" --arg plugin "$PLUGIN_ID" --arg dir "$PLUGIN_DIR" --arg theme "$THEME" --arg size "$SIZE" --argjson scale "$SCALE" --arg runtime "$RUNTIME_ROOT" --arg omarchy "$OMARCHY_PATH" --arg render "$render" --argjson shared "$SHARED" --argjson network "$NETWORK" --argjson stamp "$STAMP" --argjson created "$(date +%s)" '{format:2,name:$name,plugin:$plugin,pluginDir:$dir,theme:$theme,size:$size,scale:$scale,runtimeRoot:$runtime,omarchyPath:$omarchy,renderNode:$render,sharedBus:($shared==1),network:($network==1),stampEnabled:($stamp==1),created:$created}' > "$LAB/meta.json"
  trap startup_failed EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  stage_home; update_stamp; write_child_config
  cat > "$LAB/omalab-pipewire.conf" <<'CONFIG'
context.properties = { core.daemon = true core.name = pipewire-0 }
context.spa-libs = { support.* = support/libspa-support }
context.modules = [
 { name = libpipewire-module-protocol-native }
 { name = libpipewire-module-client-node }
 { name = libpipewire-module-metadata }
 { name = libpipewire-module-access }
]
context.objects = [ { factory = metadata args = { metadata.name = default } } ]
CONFIG
  prepare_namespace_args
  launch_external supervisor bwrap "${NAMESPACE_ARGS[@]}"
  local attempt keeper
  for ((attempt=0; attempt<450; attempt++)); do
    role_alive supervisor || fail 'session exited; inspect supervisor.log and parent.log'
    if ! role_alive namespace && keeper=$(jq -er '."child-pid"' "$LAB/supervisor-info.json" 2>/dev/null); then
      record_pid namespace "$keeper"
    fi
    if [[ -f $LAB/ready ]] && role_alive namespace; then break; fi
    sleep 0.1
  done
  (( attempt < 450 )) || fail 'isolated session did not become ready'
  run_lab omarchy-shell shell listPlugins | jq -e --arg id "$PLUGIN_ID" '.[]|select(.id==$id and .enabled)' >/dev/null || fail 'requested plugin not enabled'
  trap - EXIT INT TERM
  printf 'Lab %s is up: %s %s@%s (%s), isolated from host displays.\nShow: omalab show -n %s\nCapture: omalab shot -n %s\n' "$NAME" "$PLUGIN_ID" "$SIZE" "$SCALE" "$THEME" "$NAME" "$NAME"
}

show_lab() {
  load_lab
  namespace_alive || fail 'lab is not running'
  if role_alive viewer; then printf 'Viewer for %s is already open\n' "$NAME"; return; fi
  [[ -n ${DISPLAY:-} ]] || fail 'show needs a graphical session with DISPLAY for the TigerVNC viewer; run show from your desktop terminal'
  [[ -S $LAB/run/viewer.sock ]] || fail 'lab viewer socket unavailable'
  RUNTIME_ROOT=$(jq -er .runtimeRoot "$LAB/meta.json")
  local viewer
  viewer=$(runtime_binary vncviewer) || fail 'vncviewer is unavailable; run omalab-setup'
  mkdir -p "$LAB/viewer-home/.config" "$LAB/viewer-home/.local/state" "$LAB/viewer-home/.cache"
  launch_external viewer env HOME="$LAB/viewer-home" XDG_CONFIG_HOME="$LAB/viewer-home/.config" XDG_STATE_HOME="$LAB/viewer-home/.local/state" XDG_CACHE_HOME="$LAB/viewer-home/.cache" \
    LD_LIBRARY_PATH="$RUNTIME_ROOT/tools/usr/lib" "$viewer" \
    -AcceptClipboard=0 -SendClipboard=0 -SendPrimary=0 -SetPrimary=0 -RemoteResize=0 \
    -FullScreen=0 -Maximize=0 -FullscreenSystemKeys=0 -ReconnectOnError=0 -AlertOnFatalError=0 \
    -Shared=1 -NoJPEG=1 -SecurityTypes None -geometry "$SIZE" "$LAB/run/viewer.sock"
  sleep 0.2
  role_alive viewer || fail 'viewer exited; inspect viewer.log'
  printf 'Viewer opened for %s; close it with omalab hide -n %s\n' "$NAME" "$NAME"
}
hide_lab() { load_lab; stop_role viewer; printf 'Viewer closed for %s\n' "$NAME"; }
destroy_lab() {
  stop_role viewer
  stop_namespace
  if role_alive namespace; then fail 'namespace is still alive; refusing to remove its state'; fi
  rm -rf -- "$LAB"
}
restart_lab() {
  update_stamp
  run_lab /bin/bash /runner _restart
  printf 'Restarted %s\n' "$NAME"
}
shot_geometry() {
  write_child_config
  update_stamp
  local reply attempt
  reply=$(run_lab hyprctl reload); [[ $reply == ok ]] || fail "child refused geometry: $reply"
  for ((attempt=0; attempt<150; attempt++)); do
    if run_lab hyprctl -j monitors | jq -e --argjson w "$PIXEL_W" --argjson h "$PIXEL_H" --argjson s "$SCALE" '.[]|select(.name=="LAB" and .width==$w and .height==$h and .scale==$s)' >/dev/null; then break; fi
    sleep 0.1
  done
  (( attempt < 150 )) || fail 'child geometry did not settle'
  [[ $SHOT_RESTART == 0 ]] || run_lab /bin/bash /runner _restart
  for ((attempt=0; attempt<100; attempt++)); do
    if run_lab hyprctl -j layers | jq -e --argjson w "$PIXEL_W" --argjson h "$PIXEL_H" --argjson s "$SCALE" '..|objects|select(.namespace?=="omarchy-background" and .w==($w/$s) and .h==($h/$s))' >/dev/null; then
      if jq -e .stampEnabled "$LAB/meta.json" >/dev/null; then run_lab omarchy-shell omalab.stamp geometry "$SIZE" "$SCALE" >/dev/null; fi
      sleep 0.3
      return 0
    fi
    sleep 0.1
  done
  fail 'shell did not relayout'
}
restore_shot() {
  local status=$?
  trap - EXIT INT TERM
  if [[ $SHOT_CHANGED == 1 ]]; then
    SIZE=$SHOT_SIZE SCALE=$SHOT_SCALE; geometry
    if ! (shot_geometry); then printf 'omalab: could not restore lab geometry\n' >&2; status=1; fi
  fi
  [[ -z $SHOT_TEMP ]] || rm -f -- "$SHOT_TEMP"
  exit "$status"
}
shot() {
  load_lab
  SHOT_SIZE=$SIZE SHOT_SCALE=$SCALE SHOT_RESTART=0 SHOT_CHANGED=0 SHOT_TEMP=''
  local file=''
  while (( $# )); do
    case $1 in
      --size|--scale) [[ $# -ge 2 ]] || fail "missing value for $1"; case $1 in --size) SIZE=$2 ;; --scale) SCALE=$2 ;; esac; shift 2 ;;
      --) shift; [[ $# == 1 && -z $file ]] || fail 'shot takes one file'; file=$1; shift ;;
      -*) fail "unknown shot option: $1" ;;
      *) [[ -z $file ]] || fail 'shot takes one file'; file=$1; shift ;;
    esac
  done
  geometry
  file=$(realpath -m -- "${file:-omalab-$NAME-$SIZE@$SCALE.png}")
  [[ -d ${file%/*} && ! -d $file ]] || fail 'invalid screenshot destination'
  namespace_alive || fail 'lab is not running'
  if jq -en --argjson before "$SHOT_SCALE" --argjson after "$SCALE" '$before!=$after' >/dev/null; then
    SHOT_RESTART=1; printf 'omalab: scale change restarts the lab shell; transient state resets\n' >&2
  fi
  trap restore_shot EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  if [[ $SIZE != "$SHOT_SIZE" || $SCALE != "$SHOT_SCALE" ]]; then SHOT_CHANGED=1; shot_geometry; fi
  SHOT_TEMP=$(mktemp -- "$file.XXXXXX")
  # Only the PNG bytes cross the boundary; the child cannot write host paths.
  run_lab timeout 15 grim -o LAB - > "$SHOT_TEMP"
  if [[ $SHOT_CHANGED == 1 ]]; then SIZE=$SHOT_SIZE SCALE=$SHOT_SCALE; geometry; shot_geometry; SHOT_CHANGED=0; fi
  mv -f -- "$SHOT_TEMP" "$file"; SHOT_TEMP=''
  trap - EXIT INT TERM
  printf '%s\n' "$file"
}
list_labs() {
  printf 'NAME\tPLUGIN\tSIZE@SCALE\tTHEME\tAGE\tSTATE\n'
  local meta state now
  now=$(date +%s)
  shopt -s nullglob
  for meta in "$ROOT"/*/meta.json; do
    if ! jq -e '.format==2' "$meta" >/dev/null; then printf '%s\tlegacy backend; use original CLI for teardown\n' "${meta%/meta.json}"; continue; fi
    LAB=${meta%/meta.json}; PID_FILE=$LAB/pids; state=stopped
    if namespace_alive; then state=starting; [[ ! -f $LAB/ready ]] || state=alive; fi
    jq -r --arg state "$state" --argjson now "$now" '[.name,.plugin,(.size+"@"+(.scale|tostring)),.theme,((($now-.created)|tostring)+"s"),$state]|@tsv' "$meta"
  done
}

COMMAND=${1:---help}; (( $# == 0 )) || shift
case $COMMAND in --help|-h) usage; exit 0 ;; esac
case $COMMAND in
  _supervise) inside_supervise; exit ;;
  _run) inside_environment; cd "$HOME"; exec "$@" ;;
  _restart) inside_environment; inside_restart; exit ;;
esac
[[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]] || fail 'XDG_RUNTIME_DIR must be an owned runtime directory'
ROOT=$XDG_RUNTIME_DIR/omalab
[[ ! -L $ROOT ]] || fail 'runtime root must not be a symlink'
mkdir -p "$ROOT"
[[ -O $ROOT ]] || fail 'runtime root must be owned by this user'
SELF=$(realpath -e -- "${BASH_SOURCE[0]}")
REAL_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
REAL_STATE=${XDG_STATE_HOME:-$HOME/.local/state}
case $COMMAND in up|down|show|hide|shot|restart|input) exec 9>"$ROOT/.lock"; flock 9 ;; esac
if [[ $COMMAND == up ]]; then up "$@"; exit; fi
NAME=default NAMED=0
if [[ ${1:-} == -n ]]; then [[ $# -ge 2 ]] || fail 'missing lab name'; NAME=$2; NAMED=1; shift 2; fi
case $COMMAND in
  show|hide) [[ $# == 0 ]] || fail "$COMMAND takes only -n NAME"; if [[ $COMMAND == show ]]; then show_lab; else hide_lab; fi ;;
  shot) shot "$@" ;;
  ipc) [[ $# -ge 2 ]] || fail 'ipc requires target and method'; load_lab; run_lab omarchy-shell "$@" ;;
  exec) [[ $# -gt 0 ]] || fail 'exec requires a command'; load_lab; run_lab "$@" ;;
  input) [[ $# -gt 0 ]] || fail 'input requires an operation'; load_lab; namespace_alive || fail 'lab is not running'; python3 "${SELF%/*}/../support/input.py" request "$LAB/run/input.sock" "$@" ;;
  log) load_lab; if [[ ${1:-} == -f && $# == 1 ]]; then exec tail -n +1 -F "$LAB/shell.log"; fi; [[ $# == 0 ]] || fail 'log takes only -f'; cat "$LAB/shell.log" ;;
  restart) [[ $# == 0 ]] || fail 'restart takes no arguments'; load_lab; restart_lab ;;
  ls) [[ $# == 0 && $NAMED == 0 ]] || fail 'ls takes no arguments'; list_labs ;;
  down)
    if [[ ${1:-} == --all ]]; then
      [[ $# == 1 && $NAMED == 0 ]] || fail 'down takes -n NAME or --all'
      shopt -s nullglob
      for meta in "$ROOT"/*/meta.json; do NAME=$(jq -er .name "$meta"); load_lab; destroy_lab; done
    else [[ $# == 0 ]] || fail 'down takes -n NAME or --all'; load_lab; destroy_lab; fi ;;
  *) fail "unknown command: $COMMAND (see --help)" ;;
esac
